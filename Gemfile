source "https://rubygems.org"

# GitHub Pages builds this site with its own pinned toolchain (currently
# Jekyll 3.10). Depending on the github-pages gem keeps a local
# `bundle exec jekyll serve` on exactly the same versions as production, so a
# local preview is a faithful check of what will ship.
#
#     bundle install
#     bundle exec jekyll serve
#
gem "github-pages", group: :jekyll_plugins

# Windows does not include zoneinfo files, so bundle the tzinfo-data gem
gem "tzinfo-data", platforms: [:mingw, :mswin, :x64_mingw, :jruby]
